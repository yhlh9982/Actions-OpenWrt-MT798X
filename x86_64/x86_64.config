#WIFI驱动
# CONFIG_PACKAGE_kmod-mt7915e=y
# CONFIG_PACKAGE_kmod-mt7921e=y
# CONFIG_PACKAGE_kmod-mt7925e=y
# CONFIG_PACKAGE_kmod-mt7921-common=y
# CONFIG_PACKAGE_kmod-mt792x-common=y
# CONFIG_PACKAGE_kmod-mt7915-firmware=y
# CONFIG_PACKAGE_kmod-mt7916-firmware=y
# CONFIG_PACKAGE_kmod-mt7921-firmware=y
# CONFIG_PACKAGE_kmod-mt7922-firmware=y
# CONFIG_PACKAGE_kmod-mt7925-firmware=y

# 内核模块调整
# CONFIG_PACKAGE_kmod-hwmon-w83627ehf=y
# CONFIG_PACKAGE_kmod-hwmon-w83627hf=y
# CONFIG_PACKAGE_kmod-w83627hf-wdt=y

# ===== 文件系统扩展 =====
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ===== IPv6 完善 =====
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables-extra=y
CONFIG_PACKAGE_kmod-ip6-vti=y

# ===== 有线网卡驱动（x86 必备）=====
CONFIG_PACKAGE_kmod-igc=y            # Intel I225/I226 2.5G（最常见）
CONFIG_PACKAGE_kmod-igb=y            # Intel I210/I211/I350 千兆
CONFIG_PACKAGE_kmod-e1000e=y         # Intel 82571-82579
CONFIG_PACKAGE_kmod-e1000=y          # Intel PCI / 虚拟机常用
CONFIG_PACKAGE_kmod-r8169=y          # Realtek 内置千兆
# CONFIG_PACKAGE_kmod-r8125=y          # Realtek 2.5G（需对应 feed）
CONFIG_PACKAGE_kmod-ixgbe=y          # Intel 万兆
CONFIG_PACKAGE_kmod-i40e=y           # Intel X710/XL710
CONFIG_PACKAGE_kmod-tg3=y            # Broadcom
CONFIG_PACKAGE_kmod-vmxnet3=y        # VMware 虚拟网卡（你开了 VMDK 镜像）

# LuCI 管理界面及其运行依赖
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y

CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-mod-admin-full=y

CONFIG_PACKAGE_cgi-io=y

CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubus-lua=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uci-lua=y

CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# ==========================================
# / eBPF / BTF
# ==========================================

# BPF 编译工具链（宿主机）
CONFIG_BPF_TOOLCHAIN_HOST=y
# CONFIG_BPF_TOOLCHAIN_NONE is not set

# BPF 核心功能
CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y

# 内核调试信息及 BTF
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# cgroup / BPF events
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y

# Kprobes
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y

# 网络 ingress / egress / traffic control
CONFIG_KERNEL_NET_INGRESS=y
CONFIG_KERNEL_NET_EGRESS=y
CONFIG_KERNEL_NET_CLS_ACT=y
CONFIG_KERNEL_NET_SCH_INGRESS=m
CONFIG_KERNEL_NET_CLS_BPF=m
CONFIG_KERNEL_BPF_STREAM_PARSER=y

# XDP sockets
CONFIG_KERNEL_XDP_SOCKETS=y

# 内核模块包
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y

# tc 命令及 BPF 过滤器支持
CONFIG_PACKAGE_tc-bpf=y
CONFIG_PACKAGE_ca-bundle=y

# 使用 nftables queue / NFQUEUE 时需要
CONFIG_PACKAGE_kmod-nft-queue=y

#参数调整
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_FEED_video=n
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n

CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-dsa=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-inet-mptcp-diag=y
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-sound-core=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-audio=y
